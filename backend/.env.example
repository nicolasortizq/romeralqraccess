# Copy this file to .env and fill in real values. Never commit .env.
#
# DJANGO_SECRET_KEY: generate one, e.g.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-replace-with-a-long-random-secret

# DJANGO_DEBUG: "True" only in local development, never in production.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve this Django app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string, parsed by dj-database-url.
DATABASE_URL=postgres://romeral_user:changeme@localhost:5432/romeral_qraccess

# SMTP settings used to email tickets (QR code) to buyers.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=tickets@example.com
EMAIL_HOST_PASSWORD=changeme
EMAIL_USE_TLS=True

# WooCommerce webhook (order.paid) and REST API credentials.
WOOCOMMERCE_WEBHOOK_SECRET=changeme
WOOCOMMERCE_API_URL=https://tienda.example.com/wp-json/wc/v3
WOOCOMMERCE_API_KEY=changeme
WOOCOMMERCE_API_SECRET=changeme
